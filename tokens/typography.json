{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Typography tokens aligned to the Clerk-style Opendex reference. All sizes use px for visual parity across pages.",

  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["geistNumbers", "suisse", "suisse Fallback", "Geist Sans", "ui-sans-serif", "system-ui", "sans-serif"],
      "$description": "Primary body text using local Geist Numbers with local Suisse fallback"
    },
    "ui": {
      "$type": "fontFamily",
      "$value": ["geistNumbers", "suisse", "suisse Fallback", "Geist Sans", "ui-sans-serif", "system-ui", "sans-serif"],
      "$description": "Primary interface labels, navigation, controls and compact metadata"
    },
    "display": {
      "$type": "fontFamily",
      "$value": ["geistNumbers", "suisse", "suisse Fallback", "Geist Sans", "ui-sans-serif", "system-ui", "sans-serif"],
      "$description": "Primary heading and display type"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": ["Lora", "Georgia", "Cambria", "Times New Roman", "serif"],
      "$description": "Editorial — long-form content, marketing"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["geistNumbers", "suisse", "suisse Fallback", "Geist Sans", "ui-sans-serif", "system-ui", "sans-serif"],
      "$description": "Technical UI labels and data values use the same compact Geist-style stack unless a component explicitly requires fixed-width text"
    }
  },

  "fontSize": {
    "$description": "Clerk-style scale: controls stay compact while content text uses the same rhythm across pages.",
    "xs":   { "$type": "dimension", "$value": "13px" },
    "sm":   { "$type": "dimension", "$value": "13px" },
    "base": { "$type": "dimension", "$value": "18px" },
    "lg":   { "$type": "dimension", "$value": "23px" },
    "xl":   { "$type": "dimension", "$value": "29px" },
    "2xl":  { "$type": "dimension", "$value": "38px" },
    "3xl":  { "$type": "dimension", "$value": "48px" },
    "4xl":  { "$type": "dimension", "$value": "48px" },
    "5xl":  { "$type": "dimension", "$value": "48px" },
    "6xl":  { "$type": "dimension", "$value": "60px" },
    "7xl":  { "$type": "dimension", "$value": "72px" }
  },

  "fontWeight": {
    "regular":  { "$type": "number", "$value": 400 },
    "medium":   { "$type": "number", "$value": 500 },
    "semibold": { "$type": "number", "$value": 600 },
    "bold":     { "$type": "number", "$value": 700 }
  },

  "lineHeight": {
    "none":    { "$type": "number", "$value": 1 },
    "tight":   { "$type": "number", "$value": 1.25 },
    "snug":    { "$type": "number", "$value": 1.375 },
    "normal":  { "$type": "number", "$value": 1.5 },
    "relaxed": { "$type": "number", "$value": 1.625 },
    "loose":   { "$type": "number", "$value": 2 }
  },

  "letterSpacing": {
    "tighter": { "$type": "dimension", "$value": "-1.2px" },
    "tight":   { "$type": "dimension", "$value": "0px" },
    "normal":  { "$type": "dimension", "$value": "0em" },
    "wide":    { "$type": "dimension", "$value": "0.025em" },
    "wider":   { "$type": "dimension", "$value": "0.05em" },
    "widest":  { "$type": "dimension", "$value": "0.1em" }
  },

  "textStyle": {
    "$description": "Composite text styles — use these in components",

    "heading-1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "48px",
        "fontWeight": "{fontWeight.bold}",
        "lineHeight": "56px",
        "letterSpacing": "{letterSpacing.tighter}"
      },
      "$description": "Page titles — 48px/56px/700"
    },
    "heading-2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "38px",
        "fontWeight": "{fontWeight.medium}",
        "lineHeight": "46px",
        "letterSpacing": "{letterSpacing.tight}"
      },
      "$description": "Section titles — 38px/46px/500"
    },
    "heading-3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "29px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "35px",
        "letterSpacing": "{letterSpacing.tight}"
      },
      "$description": "Sub-sections — 29px/35px/400"
    },
    "heading-4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "23px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "28px",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Card titles — 23px/28px/400"
    },
    "heading-5": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "{fontSize.xl}",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "{lineHeight.snug}",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Widget titles — 20px/1.375/semibold"
    },
    "heading-6": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.display}",
        "fontSize": "{fontSize.lg}",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "{lineHeight.snug}",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Smallest heading — 18px/1.375/semibold"
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "18px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "28px",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Lead paragraphs — 18px/28px/400"
    },
    "body-base": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "18px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "28px",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Default body text — 18px/28px/400"
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "18px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "28px",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Secondary body text — 18px/28px/400"
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.ui}",
        "fontSize": "13px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "{lineHeight.normal}",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Captions, timestamps — 13px/1.5/regular"
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.ui}",
        "fontSize": "13px",
        "fontWeight": "{fontWeight.medium}",
        "lineHeight": "{lineHeight.normal}",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Form labels, table headers — 13px/1.5/medium"
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.ui}",
        "fontSize": "13px",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "{lineHeight.normal}",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Category labels — 13px/1.5/semibold"
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.mono}",
        "fontSize": "{fontSize.sm}",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "{lineHeight.relaxed}",
        "letterSpacing": "{letterSpacing.normal}"
      },
      "$description": "Inline and block code — 14px/1.625/regular"
    }
  }
}
